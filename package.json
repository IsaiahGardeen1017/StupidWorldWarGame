{
  "name": "world-at-war",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "map:generate": "tsx scripts/generate-map.ts",
    "map:build": "tsx scripts/compile-map.ts",
    "dev": "tsx server/index.ts",
    "build": "npm run map:build && tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "sim": "tsx scripts/sim.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "format": "prettier --write src server scripts tests editor README.md package.json tsconfig.json index.html",
    "map": "tsx server/map-editor.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
